# ============================================================
# CampusTrade 环境变量配置
# ============================================================
# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下方所有标记为 [必改] 的变量
#   3. 生产环境请勿使用默认值
#   4. .env 文件不应提交到版本控制（已在 .gitignore 中排除）
# ============================================================

# ---------------------------
# MySQL 配置
# ---------------------------
# [必改] MySQL root 密码，生产环境请使用强密码（至少16位，含大小写字母+数字+特殊字符）
MYSQL_ROOT_PASSWORD=your_secure_password_here

# MySQL 数据库名（默认 campus_trade，一般不需要修改）
MYSQL_DATABASE=campus_trade

# MySQL 用户名（Docker 容器内使用 root）
MYSQL_USERNAME=root

# ---------------------------
# Redis 配置
# ---------------------------
# [必改] Redis 密码，生产环境必须设置
REDIS_PASSWORD=your_redis_password_here

# Redis 端口（默认 6379）
REDIS_PORT=6379

# ---------------------------
# RabbitMQ 配置
# ---------------------------
# [必改] RabbitMQ 用户名
RABBITMQ_USERNAME=campustrade

# [必改] RabbitMQ 密码
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ---------------------------
# JWT 配置
# ---------------------------
# [必改] JWT 签名密钥，至少32个字符，建议64位随机字符串
# 生成方法：openssl rand -base64 48
JWT_SECRET=your_jwt_secret_at_least_32_chars_long_here

# AccessToken 过期时间（毫秒），默认2小时
JWT_ACCESS_EXPIRATION=7200000

# RefreshToken 过期时间（毫秒），默认7天
JWT_REFRESH_EXPIRATION=604800000

# ---------------------------
# CORS 跨域配置
# ---------------------------
# 允许的前端来源域名，多个用逗号分隔
# 生产环境示例：https://campustrade.com,https://admin.campustrade.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# [必改] WebSocket/STOMP 允许的来源域名，与CORS保持一致
# 生产环境示例：https://campustrade.com
CORS_ORIGINS=http://localhost:*

# ---------------------------
# 文件上传配置
# ---------------------------
# 文件上传存储路径（容器内路径）
FILE_UPLOAD_PATH=/data/uploads

# 文件访问URL前缀
FILE_UPLOAD_URL_PREFIX=/uploads

# ---------------------------
# 应用配置
# ---------------------------
# Spring Boot Profile（prod=生产, dev=开发）
SPRING_PROFILES_ACTIVE=prod

# JVM 堆内存设置（根据服务器配置调整）
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# 服务端口
SERVER_PORT=8080

# [必改] 管理员初始密码，首次部署后请登录修改
ADMIN_PASSWORD=admin123

# ---------------------------
# Nginx / 前端端口配置
# ---------------------------
# 用户端端口
FRONTEND_USER_PORT=80

# 管理端端口
FRONTEND_ADMIN_PORT=81

# ---------------------------
# 日志与监控
# ---------------------------
# Actuator 端点开放范围（health,info,metrics,prometheus）
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics,prometheus

# 日志保留天数
LOG_RETENTION_DAYS=30

# MyBatis SQL日志级别（DEBUG=输出SQL, INFO=关闭SQL日志，生产环境建议INFO）
MAPPER_LOG_LEVEL=INFO

# ---------------------------
# Prometheus / Grafana 监控
# ---------------------------
# Prometheus 服务端口
PROMETHEUS_PORT=9090

# Grafana 服务端口
GRAFANA_PORT=3000

# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ---------------------------
# DeepSeek AI 配置
# ---------------------------
# DeepSeek API Key（https://platform.deepseek.com 或 https://cloud.siliconflow.cn 获取），留空则 AI 功能停用并降级为本地FAQ
DEEPSEEK_API_KEY=

# DeepSeek API 地址（DeepSeek官方: https://api.deepseek.com/v1 | 硅基流动: https://api.siliconflow.cn/v1）
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1

# 模型名称（硅基流动: deepseek-ai/DeepSeek-V4-Flash | DeepSeek官方: deepseek-chat）
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 是否启用 AI 功能
AI_ENABLED=true

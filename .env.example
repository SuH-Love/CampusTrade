# ============================================================
# CampusTrade 环境变量配置
# ============================================================
# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下方所有标记为 [必改] 的变量为你的实际值
#   3. 生产环境请勿使用示例占位符值
#   4. .env 文件不应提交到版本控制（已在 .gitignore 中排除）
#
# 配置原理：
#   .env → docker-compose.yml (${VAR:?error}) → 容器环境变量 → application-prod.yml
#   所有敏感配置集中在此文件，无需修改 docker-compose.yml 或 application-prod.yml
#
# 强密码生成方法：
#   openssl rand -base64 24    # 适用于 MySQL/Redis/RabbitMQ 密码
#   openssl rand -base64 48    # 适用于 JWT 密钥
#   或使用 Python: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# ---------------------------
# Spring Boot Profile 配置
# ---------------------------
# Spring Boot 配置文件切换：prod=生产环境(application-prod.yml) | dev=开发环境(application.yml)
# - 生产环境(Docker部署)：使用 prod，所有配置从 .env 环境变量注入
# - 本地开发(IDE运行)：使用 dev，配置写在 application.yml 中(含弱密码仅限本地)
# - 本地运行生产配置：mvn spring-boot:run -Dspring-boot.run.profiles=prod
SPRING_PROFILES_ACTIVE=prod

# ---------------------------
# MySQL 数据库配置
# ---------------------------
# [必改] MySQL root 密码，至少16位强密码（含大小写字母+数字+特殊字符）
# 注意：此密码仅在首次初始化MySQL数据目录时生效，已有数据时需在容器内手动ALTER USER修改
MYSQL_ROOT_PASSWORD=your_secure_password_here

# MySQL 数据库名（自动创建，一般不需要修改）
MYSQL_DATABASE=campus_trade

# MySQL 用户名（Docker 容器内使用 root）
MYSQL_USERNAME=root

# ---------------------------
# Redis 缓存配置
# ---------------------------
# [必改] Redis 密码，生产环境必须设置（用于缓存/限流/Token黑名单/AI会话等）
REDIS_PASSWORD=your_redis_password_here

# Redis 端口（容器内部端口，一般不需要修改）
REDIS_PORT=6379

# ---------------------------
# RabbitMQ 消息队列配置
# ---------------------------
# [必改] RabbitMQ 用户名（不要使用默认的 guest，生产环境不安全）
RABBITMQ_USERNAME=campustrade

# [必改] RabbitMQ 密码，至少16位强密码
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ---------------------------
# JWT 认证配置
# ---------------------------
# [必改] JWT 签名密钥，至少32个字符，建议64位随机字符串
# 用于签发和验证用户登录Token，泄露后可伪造任意用户身份
JWT_SECRET=your_jwt_secret_at_least_32_chars_long_here

# AccessToken 过期时间（毫秒），默认7200000=2小时
JWT_ACCESS_EXPIRATION=7200000

# RefreshToken 过期时间（毫秒），默认604800000=7天
JWT_REFRESH_EXPIRATION=604800000

# ---------------------------
# CORS 跨域配置
# ---------------------------
# [必改] 允许的前端HTTP来源域名，多个用逗号分隔
# 用户端和管理端的域名都要列出，未列出的域名会被后端拒绝访问(CORS 403)
# 生产环境示例：https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# [必改] WebSocket/STOMP 允许的来源域名（实时聊天用），与CORS_ALLOWED_ORIGINS保持一致
# 多个域名用逗号分隔，支持通配符：https://*.yourdomain.com
# 注意：https://*.yourdomain.com 不匹配根域名 https://yourdomain.com，需显式列出
# 生产环境示例：https://yourdomain.com,https://*.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# ---------------------------
# 文件上传配置
# ---------------------------
# 文件上传存储路径（Docker容器内路径，映射到宿主机 /app/upload）
FILE_UPLOAD_PATH=/data/uploads

# 文件访问URL前缀（前端通过此路径访问上传的图片等文件）
FILE_UPLOAD_URL_PREFIX=/uploads

# ---------------------------
# 应用服务配置
# ---------------------------
# JVM 堆内存设置（根据服务器内存调整，格式: -Xms初始堆 -Xmx最大堆）
# 2GB服务器建议: -Xms512m -Xmx1024m | 4GB服务器建议: -Xms1g -Xmx2g
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# 后端服务端口（Docker容器对外暴露的端口）
SERVER_PORT=8080

# [必改] 超级管理员初始密码，首次部署时自动创建 admin 账号
# 至少12位强密码（含大小写+数字+特殊字符），首次启动后也可在管理端修改
ADMIN_PASSWORD=your_admin_password_here

# [可选] 测试用户初始密码，首次部署时自动创建 user 账号（普通用户角色）
# 仅用于开发/演示环境，生产环境建议修改为强密码或部署后在管理端删除此账号
USER_PASSWORD=user123

# ---------------------------
# Nginx / 前端端口配置
# ---------------------------
# 用户端Nginx端口
# - 无宿主机Nginx(直接Docker部署)：80
# - 有宿主机Nginx做SSL终止(生产环境)：127.0.0.1:8088（绑定本机，由宿主机Nginx反代）
FRONTEND_USER_PORT=80

# 管理端Nginx端口
# - 无宿主机Nginx(直接Docker部署)：81
# - 有宿主机Nginx做SSL终止(生产环境)：127.0.0.1:8181（绑定本机，由宿主机Nginx反代）
FRONTEND_ADMIN_PORT=81

# ---------------------------
# 日志配置
# ---------------------------
# Spring Boot Actuator 端点开放范围
# 生产环境建议仅开放 health（监控健康状态）
# 完整监控: health,info,metrics,prometheus
MANAGEMENT_ENDPOINTS_INCLUDE=health

# 日志保留天数（超过自动清理）
LOG_RETENTION_DAYS=30

# MyBatis SQL日志级别
# DEBUG=输出每条SQL语句(调试用) | INFO=关闭SQL日志(生产环境推荐)
MAPPER_LOG_LEVEL=INFO

# ---------------------------
# Prometheus / Grafana 监控配置
# ---------------------------
# 监控服务端口均绑定 127.0.0.1，仅本机可访问，外网无法直接连接
# 需通过 SSH 隧道访问：ssh -L 3000:localhost:3000 root@yourserver

# Prometheus 监控采集端口
PROMETHEUS_PORT=9090

# Grafana 监控面板端口
GRAFANA_PORT=3000

# Grafana 管理员用户名
GRAFANA_ADMIN_USER=admin

# [必改] Grafana 管理员密码，至少12位强密码
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ---------------------------
# DeepSeek AI 助手配置
# ---------------------------
# DeepSeek API Key，留空则 AI 功能停用并降级为本地FAQ
# 获取地址：https://platform.deepseek.com（DeepSeek官方）或 https://cloud.siliconflow.cn（硅基流动）
# 注意：也可部署后在管理端"系统配置→AI配置"页面设置（存储在Redis中，优先级高于此处）
DEEPSEEK_API_KEY=

# DeepSeek API 基础URL
# DeepSeek官方: https://api.deepseek.com/v1 | 硅基流动: https://api.siliconflow.cn/v1
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1

# AI 模型名称
# 硅基流动: deepseek-ai/DeepSeek-V4-Flash | DeepSeek官方: deepseek-chat
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 是否启用 AI 助手功能（true=启用, false=停用）
AI_ENABLED=true

# ---------------------------
# 支付宝配置（可选）
# ---------------------------
# 支付宝沙箱密钥不在此配置，部署后在管理端"系统配置→支付宝配置"页面设置（AES加密存储）
# 此处仅配置回调URL，需替换为你的实际域名

# [必改] 支付宝异步回调通知URL（支付成功后支付宝回调此地址）
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/order/pay/notify

# [必改] 支付宝同步返回URL（支付完成后浏览器跳转地址）
ALIPAY_RETURN_URL=https://yourdomain.com/order/

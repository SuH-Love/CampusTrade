<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campustrade.mapper.AiFeedbackMapper">

    <resultMap id="BaseResultMap" type="com.campustrade.entity.AiFeedback">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="message_id" property="messageId"/>
        <result column="user_message" property="userMessage"/>
        <result column="ai_response" property="aiResponse"/>
        <result column="rating" property="rating"/>
        <result column="feedback" property="feedback"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
        <result column="version" property="version"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_ai_feedback (user_id, session_id, message_id, user_message, ai_response, rating, feedback)
        VALUES (#{userId}, #{sessionId}, #{messageId}, #{userMessage}, #{aiResponse}, #{rating}, #{feedback})
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM t_ai_feedback WHERE deleted = 0 AND user_id = #{userId}
        ORDER BY create_time DESC LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCountByUserId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_ai_feedback WHERE deleted = 0 AND user_id = #{userId}
    </select>

    <select id="selectAvgRating" resultType="java.lang.Double">
        SELECT AVG(rating) FROM t_ai_feedback WHERE deleted = 0
    </select>
</mapper>